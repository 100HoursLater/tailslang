using "config"
using "std"
using "myclass" from "./myclass.tails"

namespace std;

class Types {

    ++ // interator up 
    -- // interator down

    var // var is how you declare a mutable variable 
    const // const is how you declare an immutable variable 
    
    // tails is a mixed typed type language, 

    int, float, string, char // these are explicit types and can be used in the traditional C/C++ way but you can do implicit declaration via var or const

    static // is how you declare a function 

    static MyFunction() {...} // for instance 

    class MyOverLoad {...}  // class nesting

    // operands (operands means operators)

    = //Simple Assignment 
    == //Simple Comparison 
    === //strictly equals (this applies to only strings and numbers)

    <= // less than or equals to
    => // more than or equals to

    > // more than 

    < // less than 

    != // not equal 

    !=== // strictly not equals 

    - // substraction 
    + // addition 

    * // multiplication 

    / // division 

    += // compound assignment operator 

    -= // compound assignment operator  

    & // Literal AND -> this AND that, this is completed AND then that is completed 

    && // Boolean AND -> This AND returns a boolean 

    !&& // NAND 

    &&& // Bitwise AND

    // -----

    || // Boolean OR

    ^ // XOR

    | // Bitwise OR

//----------
!/*variable*/ //NOT 

// operator oveloading is allowed










    

   







}

class Math {

    // tails follows bodmas

    // implicit types: 

    var i = 1 
    var o = 2

    i + o // 1 + 2, howevere if a bracket comes before it 

    (i + o + 3 ) & i + o // 1 + 2 + 3 and then 1 + 2 again, it goes brackets - if no, division - if no, multipliction - if no, additon - if no, subtraction
    
    // explicit types, when declaring explicit types, you have to put a comma between them this is unlike implicit types 

    int e = 10,
    int o = 20,

 

    i + o // 1 + 2, it's the same as implicit types 

    // poly equations 

    var iy = 100 
    var ix = 200
    var iz = 300
    var yx = 30

    const xi = 1000
    const yi = 2000
    const zi = 3000
    

    static MyEquastion() {

        (iy * ix - 5 & xi * iz = yx) * (xi * yx -= 80 & ix) // bodmas here, brackets first then it mutiplies the resulting number of the first bracket with the resulting number of the next bracket
        pow(ix, 2) + pow(yx, 3) * iz // indices aka power of, pow() is the function thats included inside of std library, we choose a starting number or variable and then put a comma and then say what we would like to power of that variable or literal number by

        for->(i = 0; i < 10; i++) {
           // do something
        }





    } 









}

// inheritence 

class MyMath extends math {

    //MyMath now inherits the values, function or other classes inside of the base class


};

class NewMath supersedes math {

    //superceeds replaces the base class, instead of inheriting it replaces it


};

class BetterMath superset math {

    //a superset inherits the values, functions or other classes inside of math while not sharing any changes back to the base class


};

class PoorMansMath subset math {

    //a subset doesn't inherit anything but functions from the base class 



};

// comments

// single line

/*this
is
multi
line
comment
*/

/**
