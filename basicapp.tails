    */)






// tails is a VM language and it works like Java, and it uses a language server 

// T2026 standard is the latest, and it adds: 

/*
1. superset and subset 
2. removes the `function` keyword 
3. adds explicit types
4. adds class overloading and async functions 

*/

// async functions

async static MyAsyncFunction() {

    await /*value*/ {
        // do something
    }


}

// enums 

enum MyEnum {
    
    1 = /*value*/,
    2 = /*value */,

    // and repeat


}

// interfaces 

interface MyInterface {

    // inside of interfaces is where you can wrap whole classes and function up, and use it like your own namespace of which namespace std is literally just interface std inside of the std.go file



}

// Generics 

OBJECT MyObject[/*value*/] {
    //do something
}

array MyArray = [

    //fill in that array
    //arrays can carry strings, variables or numbers
    // for loops, can either hold a variable `i` or an array, and you can use a for loop to iterate through the array


]

Generic MyGeneric {
// do something

// the Generic keyword allows you to declare well whatever you want, it could be cho-cho trains or perhaps the eiffletower, it really doesn't matter-
// it allows you to almost anything, it is the ultimate DIY keyword
} 

// flow control 

if (/*condition*/) {/*do something*/} 

// if else 

if (/*condition*/) {

    /*do something*/

} else if (/*condition*/) {

    /*do something*/

} else {

    // final check or something, else is reached if both conditionals evaluate at false 


} 

// hello world

// works outside of a class 

print("Hello, World")

// newline shit

print("Hello, World")
print("I love TAILS") // newline is the literal next print, it becomes: 

/*
Hello, World
I love TAILS
*/

// inside of a class 

class HelloWorld {

    print("HelloWorld")


}

// inside of a function 

static HelloWorld() {

    print("HelloWorld")


}

// inside of an Async Function 

print("Helloworld")

async static Helloworld() {
    await print() {

        print("I LOVE TAILS")
        
    }
}

// once the print above the async func completes it runs the async print


// C parser

class C_parser {

    class C_Helpers {

        int SL_linecount = 0,
       


    }

    var C_IMPORTS = "#include" & "<...>"
    
    async static Imports() {
        await = C_IMPORTS {

            for->(SL_linecount = 0; SL_linecount => 10; i++) {

              if (SL_linecount => 10) {

                print(SL_linecount)


              } else if (SL_linecount <= 10) {

                print("Perhaps your include is malformed")


              } else if (SL_linecount <= 5) {

                print("Okay, your include is SERIOUSLY MALFORMED")


              } else if (SL_linecount == 0) {

                print("Okay What the fuck?!")


              } else (SL_linecount == null) {

                print("No includes present")


              }
                
            }
            
        }
    }

   

    


    
}

